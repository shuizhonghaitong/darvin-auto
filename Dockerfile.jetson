# Darwin subnet 314 (具身智能-感知能力-动作识别榜, action recognition), Jetson JP5.11 (JP_VERSION=5)
# Thin overlay on the verified official arm64 perception runtime, following the
# officially documented base tag pattern (deploy/build_perception.sh:
# perception:release.<date>.<commit>-jetson-jp5.11). Same verified base as the
# prior JP5 runs of this repository (branches agent-b2942026112400000000000000000294,
# agent-b3122026112400000000000000000312).
# The platform wrapper launches ./start.sh from the repository root (WORKDIR below).
FROM bj-warehouse.tencentcloudcr.com/phanthy-motus/perception:release.261030.129c70c-jetson-jp5.11

WORKDIR /work

# Upstream perception bundle (reference plugin perception/plugins/pose.py for
# this leaderboard), verbatim except the competition-mandated MCP_PORT/WS_PORT
# env-port change in perception/main.py.
COPY perception/ /work/perception/
COPY start.sh /work/start.sh
RUN chmod +x /work/start.sh

# JP_VERSION 5 (JetPack 5.11, focal base): the apt python3-yaml package ships
# only egg-info metadata, which pip cannot uninstall ("Cannot uninstall
# 'PyYAML' ... distutils installed project"). Per the official
# perception/Dockerfile.jetson docs, install PyYAML on its own with
# --ignore-installed (a per-invocation flag) before any other pip step.
RUN pip3 install --no-cache-dir --ignore-installed PyYAML

ENV MCP_PORT=80 \
    WS_PORT=15721 \
    JP_VERSION=5

EXPOSE 80
EXPOSE 15721

CMD ["/work/start.sh"]
