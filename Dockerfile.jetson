# Darwin subnet 273 (1000000273) 具身智能-TTS基础能力-不限音色榜v5 (多语种 jp5,6)
# Jetson JP6 target (JP_VERSION=6) — run id agent-d2732026112400000000000000000273
#
# Delivery: github-commit. The platform runs the official sut shell
# (harbor-contest.4pd.io/wanglimin/sut/robot_tts:0.0.4) which clones this repo
# at PHANTHYMOTUS_COMMIT_ID; we do NOT build or push a custom business image
# to ACR. This file is the repo-level build entry for the JP6 machine; the
# full upstream build context (deploy/, perception/, ...) is vendored at the
# repo root as well, so perception/Dockerfile.jetson (the official 702-line
# build, context = repo root) stays buildable from this branch unchanged.
#
# JP_VERSION=6 (JetPack 6.1, jammy base): per the official docs the
# --ignore-installed pip fix is JP5-only, so no such line is needed here.
FROM bj-warehouse.tencentcloudcr.com/phanthy-motus/perception:release.261030.129c70c-jetson-jp6.1

WORKDIR /work

# Reference TTS plugin and the full perception tree, with:
#  - competition-mandated MCP_PORT/WS_PORT env-port reads in main.py,
#  - GET /ready + GET / (sut chart readiness probe: curl -s -f localhost:80/ready),
#  - /tts/test optional per-case language field,
#  - per-utterance language detection in plugins/tts.py (kokoro-multi),
#  - config.yaml: engine kokoro-multi, device gpu, TTS-only plugin set.
COPY perception/ /work/perception/
COPY start.sh /work/start.sh
RUN chmod +x /work/start.sh

ENV MCP_PORT=80 \
    WS_PORT=15721 \
    TTS_PLUGIN=tts \
    JP_VERSION=6

EXPOSE 80
EXPOSE 15721

CMD ["/work/start.sh"]
