# Darwin subnet 276 — 具身智能-感知能力-OCR中英文 V4, Jetson JP6 (JP_VERSION=6).
#
# INFORMATIONAL ONLY. This leaderboard uses github-commit delivery: the platform
# runs the official sut shell (harbor-contest.4pd.io/wanglimin/sut/robot_ocr:0.0.4)
# and clones our repo @ PHANTHYMOTUS_COMMIT_ID. We do NOT build or push a custom
# business image from this file.
#
# JP_VERSION targets 6 only (does not include 5), so per the official docs no
# --ignore-installed flag is added to any pip3 install.
FROM bj-warehouse.tencentcloudcr.com/phanthy-motus/perception:release.261030.129c70c-jetson-jp6.1

WORKDIR /work
COPY perception/main.py /work/main.py
COPY perception/plugins/ /work/plugins/
COPY start.sh /work/start.sh
RUN chmod +x /work/start.sh

ENV JP_VERSION=6
