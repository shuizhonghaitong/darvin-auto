# ── Jetson GPU variant — LEAN build for the Darwin VOP subnet (1000000294) ──
#
# This Dockerfile is the reference perception image reduced to the modules the
# VOP leaderboard actually exercises: the topic-less vop recognize path.
#
# Why it exists: the reference image is ~14.6 GB and its runtime loads the
# whole perception stack (ASR/TTS/OCR/pose/face/ROS2). On the shared Jetson
# Orin-8G box the platform runs several competitors' inference containers at
# once over the SAME 8 GB of unified CPU+GPU memory; the reference footprint
# per instance OOMs the box (exit 137). This build keeps only:
#
#   * the same base image (jetson-base:jp${JP_VERSION}-torch — CUDA, TensorRT,
#     OpenCV, ROS2 present but NOT imported in lean mode),
#   * PyYAML / websockets / numpy (base-pinned) / pillow,
#   * the 220-class open-vocabulary nano detector ONNX (baked below),
#   * the perception code, run exactly as the reference CMD runs it.
#
# Dropped, with reasons (each was measured on the reference image, see its
# history): audio_msgs colcon build (music/speaker topics only), sherpa-onnx
# CUDA wheels + tflite + webrtcvad (ASR/TTS only), rapidocr/pyvips (OCR only),
# espeak-ng/phonemizer/wetext/kaldifst/janome (TTS frontends only), zxing-cpp
# (barcode only), vits2-trt steps (TTS only), jsonschema (PR test-suite only).
#
# The vop hot path additionally skips cv2 (VOP_NO_CV2=1) and the ROS2 runtime
# (lean mode in main.py, auto when vop is the only enabled plugin), so a full
# instance is python + numpy + pillow + websockets + tensorrt + one nano
# FP16 engine with a capped workspace — well under 1.5 GB resident.
#
# Build context: repo root (same as the reference file), so every COPY source
# below exists in the committed tree.
#
# Usage:
#   docker build --build-arg JP_VERSION=511 -f perception/Dockerfile.jetson .
#
# ── Everything that differs per JetPack line, resolved once ──────────────────
ARG PYPI_MIRROR=https://pypi.tuna.tsinghua.edu.cn/simple/
ARG APT_MIRROR=mirrors.tuna.tsinghua.edu.cn
ARG JP_VERSION=511

FROM bj-warehouse.tencentcloudcr.com/phanthy-motus/jetson-base:jp${JP_VERSION}-torch
ARG PYPI_MIRROR APT_MIRROR JP_VERSION

ARG NUMPY_VERSION_DEFAULT=1.24.4
RUN case "${JP_VERSION}" in \
        61) NUMPY=1.26.4 ;; \
        *)  NUMPY="${NUMPY_VERSION_DEFAULT}" ;; \
    esac; \
    printf 'NUMPY_VERSION=%s\nPY_ABI=%s\nDLA_COMPILER_SO=\nSHERPA_GPU_WHEEL=\n' \
        "${NUMPY}" \
        "$(python3 -c 'import sys; print("%d.%d" % sys.version_info[:2])')" \
        > /etc/jetpack.env && \
    echo "[build] lean jp${JP_VERSION}:" && cat /etc/jetpack.env

# Fix broken system cv2 __init__.py on jp5.11 (mat_wrapper circular import).
# Kept even though lean mode defaults to VOP_NO_CV2=1: the cv2 fallback paths
# (PIL missing, or VOP_NO_CV2=0) must not die on a broken import.
RUN . /etc/jetpack.env; \
    CV2_DIR="/usr/lib/python${PY_ABI}/dist-packages/cv2"; \
    python3 -c "import cv2" 2>/dev/null || { \
      echo "[build] repairing ${CV2_DIR}/__init__.py" && \
      printf '%s\n' \
        'import importlib.util, sys, os, glob' \
        '_here = os.path.dirname(__file__)' \
        '_hits = glob.glob(os.path.join(_here, "python-*", "cv2*.so")) or glob.glob(os.path.join(_here, "cv2*.so"))' \
        '_spec = importlib.util.spec_from_file_location("cv2", _hits[0])' \
        '_mod = importlib.util.module_from_spec(_spec)' \
        '_spec.loader.exec_module(_mod)' \
        'sys.modules["cv2"] = _mod' \
        > "${CV2_DIR}/__init__.py"; \
    }

# ── Python deps: the complete lean runtime set ──────────────────────────────
# numpy is pinned to whatever the base torch/cv2 stack ships (each JetPack line
# differs) so nothing in the base is upgraded under it. pillow replaces the
# cv2 decode/resize in the vop hot path (VOP_NO_CV2). websockets serves the
# WS port the platform expects (ASR is disabled; the listener itself stays).
RUN . /etc/jetpack.env; \
    pip3 install --no-cache-dir -i ${PYPI_MIRROR} --ignore-installed PyYAML && \
    pip3 install --no-cache-dir -i ${PYPI_MIRROR} \
        "numpy==${NUMPY_VERSION}" "pillow>=7.1.2" websockets && \
    python3 -c "import yaml, numpy, PIL, websockets; \
print('[build] lean deps ok:', numpy.__version__, PIL.__version__)"

# ── 220-class vop model, baked into the image ───────────────────────────────
# YOLOE-26n-seg (open vocabulary, nano backbone, <5M detection params) exported
# with the 220 leaderboard class names frozen (set_classes, nms=False,
# 640x640) — the same export the reference uses for its 144-class small
# engine, so the runtime decode path is unchanged. The .onnx is built at
# container start against this image's own TensorRT (static, FP16, workspace
# capped at 192 MB by plugins/vop_light_runtime.py) and cached in /models.
#
# It is fetched from a pinned GitHub release (public repo; the Orins reach
# github.com — see tools/export_vision_engines.py). The download is NOT fatal:
# if it fails, the runtime falls back to the reference COS bundle (the
# 144-class prebuilt engine), so a flaky network at build time degrades
# accuracy instead of breaking the build.
ARG VOP_ONNX_SHA256=65fa109b0ccc8f1748458a7134d1c4b6d71ee60a3cf9112c4d9333085e870f70
ARG VOP_VOCAB_SHA256=7dfc0fae36eb34f6205af1994fb3a24a8a853ba478fd8dad55fe64fec747b707
RUN set -x; \
    mkdir -p /opt/vop-models && \
    python3 - <<'PY' || echo "[build] vop light model NOT baked — runtime will use the reference bundle"
import hashlib, json, sys, urllib.request

base = "https://github.com/shuizhonghaitong/darvin-auto/releases/download/agent-cb294026112500000000000000000294-vop-models-v1"
pins = {
    "vop220.onnx": "65fa109b0ccc8f1748458a7134d1c4b6d71ee60a3cf9112c4d9333085e870f70",
    "vocab220.json": "7dfc0fae36eb34f6205af1994fb3a24a8a853ba478fd8dad55fe64fec747b707",
}
dest = {
    "vop220.onnx": "/opt/vop-models/vop220.onnx",
    "vocab220.json": "/opt/vop-models/vocab220.json",
}
for name, want in pins.items():
    url = f"{base}/{name}"
    print(f"[build] downloading {url}")
    urllib.request.urlretrieve(url, dest[name])
    got = hashlib.sha256(open(dest[name], "rb").read()).hexdigest()
    if got != want:
        print(f"[build] SHA256 MISMATCH for {name}: {got} != {want}", file=sys.stderr)
        sys.exit(1)
    print(f"[build] {name} ok ({got[:16]}..., {__import__('os').path.getsize(dest[name])} bytes)")
PY

# ── Application code (same layout as the reference image) ────────────────────
WORKDIR /work
COPY perception/main.py    /work/main.py
COPY perception/plugins/   /work/plugins/
COPY perception/utils/     /work/utils/
COPY perception/config.yaml /work/config.yaml
COPY perception/deploy/    /deploy/

# Compile-check the entry path on the image's own interpreter: a syntax error
# here fails the build instead of the first judged request.
RUN cd /work && python3 -m py_compile main.py plugins/vop.py plugins/vop_light_runtime.py \
    plugins/vision_runtime.py plugins/image_input.py utils/tensorrt_runtime.py \
    utils/model_downloader.py && echo "[build] lean code compiles"

# ── ROS2 python path (lean mode never imports rclpy, but a non-lean override
#    via VOP_LEAN=0 must still find it) ──────────────────────────────────────
RUN . /etc/jetpack.env; \
    PTH="/usr/local/lib/python${PY_ABI}/dist-packages/ros_ws.pth"; \
    find /opt/ros/humble/install -name "site-packages" -type d > "${PTH}" && \
    echo "[build] ${PTH}:" && cat "${PTH}"

ENV LD_LIBRARY_PATH="/opt/ros/humble/install/lib:${LD_LIBRARY_PATH}"
ENV AMENT_PREFIX_PATH="/opt/ros/humble/install"

# Lean hot path: PIL decode/resize, numpy HSV — no OpenCV import.
ENV VOP_NO_CV2=1
ENV PYTHONUNBUFFERED=1
ENV RCUTILS_COLORIZED_OUTPUT=0

EXPOSE 15720
EXPOSE 15721

CMD ["/bin/bash", "-c", \
    "source /opt/ros/humble/install/setup.bash && \
     source /etc/dla-fallback.env && \
     python3 /work/main.py"]
